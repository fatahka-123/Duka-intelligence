# Generate a unique secret before deployment: python -c "import secrets; print(secrets.token_urlsafe(48))"
DUKA_SECRET_KEY=replace-with-a-long-random-secret
# Use a managed PostgreSQL database in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/duka
COOKIE_SECURE=true
ENVIRONMENT=production
# Optional
# SESSION_DAYS=7
# DEFAULT_TIMEZONE=Africa/Nairobi
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# AUTO_CREATE_TABLES=false   # defaults to true only for local SQLite

# --- v0.3 smart features
# Public HTTPS address of this deployment (M-Pesa callbacks and lender links are built from it)
PUBLIC_BASE_URL=https://your-duka-domain.example
# Fernet key for encrypting per-shop Daraja secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DUKA_ENCRYPTION_KEY=
# Automation: in-process scheduler (default on). With several instances, turn it off and call POST /internal/cron every minute instead.
ENABLE_SCHEDULER=true
CRON_SECRET=
# Only accept M-Pesa callbacks from Safaricom's published IPs (make sure X-Forwarded-For comes from a trusted proxy)
MPESA_ENFORCE_IPS=false
# WhatsApp Cloud API (owner summaries, reminders). Outside the 24h window WhatsApp requires an approved template:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Africa's Talking SMS (fallback or primary). Use AT_USERNAME=sandbox for testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
